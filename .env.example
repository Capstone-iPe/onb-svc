# Copy to .env, fill the blanks, then load it before starting:
#   set -a; source .env; set +a
# python -m onb reads the environment. It does not open this file.

# postgresql://USER:PASSWORD@localhost:5432/ipe_onb when the role has a password.
# Leave empty to keep applications in memory until the process stops.
DATABASE_URL=postgresql://localhost:5432/ipe_onb
PORT=8000

# Same Google web client as copilot-web-app and copilot-svc.
# Register http://127.0.0.1:8000/auth/google/callback on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONB_PUBLIC_URL=http://127.0.0.1:8000
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ENFORCE_ALLOWED_EMAILS=0
# GOOGLE_ALLOWED_AUDIENCES=

# Hosted chat, used when DOCUMENT_VERIFIER_MODE=llm (the default).
# CHAT_CA_CERT must be an absolute path to vm06-ca.crt.
# Leave CHAT_API_KEY empty to use the rules checker.
DOCUMENT_VERIFIER_MODE=llm
CHAT_API_KEY=
CHAT_BASE_URL=https://103.42.50.41:1032/v1
CHAT_MODEL=Qwen/Qwen3-8B
CHAT_CA_CERT=

# Local onb-corpus. Same CORPUS_API_KEY as that service.
CORPUS_SEARCH_URL=http://127.0.0.1:8081
CORPUS_API_KEY=
